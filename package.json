{
  "name": "virtual-training-demo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-led one-to-one live interactive training. Gemini for teaching and Q&A, Deepgram for speech to text and text to speech.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions react-server --test \"src/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "golden": "tsx --conditions react-server scripts/golden-prompts.ts",
    "prompt-size": "tsx --conditions react-server scripts/prompt-size.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.8.0",
    "@google/genai": "^2.17.1",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
