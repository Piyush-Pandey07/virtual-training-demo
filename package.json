{
  "name": "virtual-training-demo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-led one-to-one live interactive training. Gemini for teaching and Q&A, Deepgram for speech to text and text to speech.",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions react-server --test \"src/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\"",
    "golden": "tsx --conditions react-server scripts/golden-prompts.ts",
    "prompt-size": "tsx --conditions react-server scripts/prompt-size.ts",
    "answer-quality": "tsx --conditions react-server scripts/answer-quality.ts",
    "ablate": "tsx --conditions react-server scripts/ablate-answer-prompt.ts",
    "migrate-roster": "tsx --conditions react-server --env-file=.env.local scripts/migrate-roster.ts",
    "provision-org": "tsx --conditions react-server --env-file=.env.local scripts/provision-org.ts",
    "migrate-orgs": "tsx --conditions react-server --env-file=.env.local scripts/migrate-orgs.ts",
    "compare-models": "tsx --conditions react-server --env-file=.env.local scripts/compare-analysis-models.ts",
    "compare-batch": "tsx --conditions react-server --env-file=.env.local scripts/compare-batch-size.ts"
  },
  "overrides": {
    "jose": "^5.10.0"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.8.0",
    "@google/genai": "^2.17.1",
    "@vercel/blob": "^2.8.0",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "^16.3.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
