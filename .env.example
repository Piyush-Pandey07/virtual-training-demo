# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own keys. Never commit .env.local.
# ---------------------------------------------------------------------------

# Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deepgram, used for both speech to text and text to speech.
# Create a key at https://console.deepgram.com. Needs at least Member permissions
# so the server can mint short-lived browser tokens.
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning.
#
# Every value below is optional and the defaults live in src/lib/config.ts. Leave
# them blank unless you are deliberately overriding one, so there is a single
# source of truth for what the app runs on. A deployment needs only the two keys
# above.
# ---------------------------------------------------------------------------

# Model for the trainer's turns. Default: gemini-2.5-flash.
# gemini-3.7-flash was tried and reverted: it narrates in stubs, roughly a quarter
# of the intended length, for no latency gain. If you change this, check narration
# length on slides 2, 4 and 5 rather than judging it on a short question.
GEMINI_MODEL=

# Model for answering questions, the hardest thing the trainer does.
# Default: whatever GEMINI_MODEL resolves to. Try gemini-pro-latest to trade
# latency for depth.
GEMINI_ANSWER_MODEL=

# Deepgram speech to text model. Default: nova-3.
DEEPGRAM_STT_MODEL=

# Deepgram text to speech voice. Default: aura-2-thalia-en.
# Full list: https://developers.deepgram.com/docs/tts-models
DEEPGRAM_TTS_MODEL=

# Lifetime in seconds of the browser token minted for live transcription.
# Default: 300. It only has to outlive the initial WebSocket handshake.
DEEPGRAM_TOKEN_TTL_SECONDS=
