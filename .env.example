# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own keys. Never commit .env.local.
# ---------------------------------------------------------------------------

# Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deepgram, used for both speech to text and text to speech.
# Create a key at https://console.deepgram.com. Needs at least Member permissions
# so the server can mint short-lived browser tokens.
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning. The defaults below are applied when a value is left blank.
# ---------------------------------------------------------------------------

# Gemini model used for narration and question answering.
GEMINI_MODEL=gemini-2.5-flash

# Deepgram speech to text model.
DEEPGRAM_STT_MODEL=nova-3

# Deepgram text to speech voice. Full list: https://developers.deepgram.com/docs/tts-models
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Lifetime in seconds of the browser token minted for live transcription.
DEEPGRAM_TOKEN_TTL_SECONDS=300
