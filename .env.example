# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own keys. Never commit .env.local.
# ---------------------------------------------------------------------------

# Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deepgram, used for both speech to text and text to speech.
# Create a key at https://console.deepgram.com. Needs at least Member permissions
# so the server can mint short-lived browser tokens.
DEEPGRAM_API_KEY=

# Sarvam, which speaks Hindi. Optional: with it set, the start screen offers Hindi
# as well as English; without it, sessions are English only, exactly as before.
# English never uses Sarvam. Create a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Which languages every trainee is offered, as codes separated by commas. The others
# (en-IN, mr, ta, te, kn, ml, bn, gu) are offered to Technavious's own people only, for
# UAT, until a speaker of the language has checked it. Defaults to English and Hindi.
# LANGUAGES_FOR_EVERYONE=en,hi

# OpenAI, for the OpenAI test page only. Optional: Technavious administrators can
# hear OpenAI's voices and compare its transcription with Deepgram's. Nothing in a
# training session uses OpenAI. Create a key at https://platform.openai.com
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning.
#
# Every value below is optional and the defaults live in src/lib/config.ts. Leave
# them blank unless you are deliberately overriding one, so there is a single
# source of truth for what the app runs on. A deployment needs only the two keys
# above.
# ---------------------------------------------------------------------------

# Model for the trainer's turns. Default: gemini-2.5-flash.
# gemini-3.7-flash was tried and reverted: it narrates in stubs, roughly a quarter
# of the intended length, for no latency gain. If you change this, check narration
# length on slides 2, 4 and 5 rather than judging it on a short question.
GEMINI_MODEL=

# Model for answering questions, the hardest thing the trainer does.
# Default: whatever GEMINI_MODEL resolves to. Try gemini-pro-latest to trade
# latency for depth.
GEMINI_ANSWER_MODEL=

# Deepgram speech to text model. Default: nova-3.
DEEPGRAM_STT_MODEL=

# Deepgram text to speech voice. Default: aura-2-thalia-en.
# Full list: https://developers.deepgram.com/docs/tts-models
DEEPGRAM_TTS_MODEL=

# Lifetime in seconds of the browser token minted for live transcription.
# Default: 300. It only has to outlive the initial WebSocket handshake.
DEEPGRAM_TOKEN_TTL_SECONDS=

# Sarvam text to speech model for Hindi. Default: bulbul:v3.
SARVAM_TTS_MODEL=

# The OpenAI test's models. Defaults: gpt-4o-mini-tts and gpt-4o-transcribe.
OPENAI_TTS_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# Learner profiles, the privacy notice everybody agrees to at sign-in, and the bulk
# participant upload. Default: on for everybody, so blank or unset is the same as
# "true". "staff" is Technavious's own people only. "off" (or "false") switches it off
# for everybody; so does any other value, so a typo collects nothing. The privacy notice
# (src/lib/profiles/notice.ts) is still a draft awaiting Technavious's approval, and the
# DPDP Act 2023 applies: set "off" or "staff" on a deployment real customers use until
# it is approved.
PROFILES_ENABLED=

# Who approves a deck before it can be assigned, and again after any change to it or
# after it is withdrawn (AI-39). SRIKANT'S ADDRESS GOES HERE. Comma separated, like
# PLATFORM_ADMIN_EMAILS below. While this is blank every Technavious administrator may
# approve, so UAT works before it is set; once it holds an address, only the people
# listed may approve.
#
#   DECK_APPROVERS=srikant@example.com
DECK_APPROVERS=

# The secret Vercel Cron sends to the daily retention job (/api/cron/retention), which
# restricts learner profiles, assessment results and feedback 90 days after a
# participant's last session and deletes them a year after last use. Vercel adds it to
# every cron call as "Authorization: Bearer <value>" once it is set here. Use a long
# random value, for example from `openssl rand -hex 32`. Unset, the job answers 404 to
# everybody, Vercel included, so nothing is ever restricted or deleted.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Sign-in (Firebase Authentication, Microsoft provider).
#
# Without these the app has no sign-in, so nothing is reachable on a deployment
# and local development falls back to a stand-in that takes your word for who
# you are. That stand-in refuses to run on Vercel or in a production build.
# ---------------------------------------------------------------------------

# The browser half. Public by design: these identify the project and are shipped
# in the bundle to every visitor whatever you do. What protects the project is
# the authorised-domain list and the server checks, not their secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The server half, from Project settings -> Service accounts -> Generate new
# private key. FIREBASE_PRIVATE_KEY is the one genuinely secret value here: it
# can mint credentials for any account in the project. Paste it including the
# BEGIN and END lines; the literal \n sequences are unescaped on read.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Technavious staff, who may read across every customer for support. Administrators
# by configuration whatever the stored role says, so the first one cannot be locked
# out waiting for another to promote them, and a lockout is fixed by an environment
# variable rather than a database console.
#
# An environment variable rather than a database row on purpose: a row can be written
# by anything that can write rows, and this can only be changed by whoever deploys.
#
# COMMA SEPARATED, one variable holding the whole list. Not one variable per person --
# a second variable of the same name is rejected, and a value split across two lines
# parses as a single unusable entry. Spaces around the commas are fine.
#
#   PLATFORM_ADMIN_EMAILS=first@example.com,second@example.com
#
# Check what a deployment actually read with GET /api/health, which reports the
# variable name it used and how many addresses parsed out of it.
PLATFORM_ADMIN_EMAILS=

# The former name for the line above, read only when PLATFORM_ADMIN_EMAILS is unset so
# a deployment does not lose its administrators between a config change and a deploy.
# Remove it once the new one is set.
AUTH_ADMIN_EMAILS=

# ALLOWED_EMAIL_DOMAINS is gone. Which domains enrol into which customer now lives in
# the `directory-domains` collection, written by `npm run provision-org`, because one
# deployment-wide list cannot describe more than one customer.
